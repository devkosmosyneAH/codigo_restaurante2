{
  "rules": {
    ".read": false,
    ".write": false,

    "restaurantes": {
      "$restaurantId": {
        ".read": false,
        ".write": "auth != null && (root.child('auth').child(auth.uid).child('admin').val() == true || root.child('auth').child(auth.uid).child('restaurant_ids').val().contains($restaurantId))",

        "productos": {
          "$productoId": {
            ".read": true,
            ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true",
            ".validate": "newData.hasChildren(['id', 'restaurant_id', 'nombre', 'precio']) && newData.child('restaurant_id').val() == $restaurantId && newData.child('nombre').isString() && newData.child('nombre').val().length > 0 && newData.child('precio').isNumber() && newData.child('precio').val() >= 0"
          }
        },

        "categorias": {
          "$categoriaId": {
            ".read": true,
            ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true",
            ".validate": "newData.hasChildren(['id', 'restaurant_id', 'nombre']) && newData.child('restaurant_id').val() == $restaurantId && newData.child('nombre').isString() && newData.child('nombre').val().length > 0"
          }
        },

        "variantes": {
          "$varianteId": {
            ".read": true,
            ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true",
            ".validate": "newData.hasChildren(['id', 'producto_id', 'nombre', 'precio']) && newData.child('nombre').isString() && newData.child('precio').isNumber() && newData.child('precio').val() >= 0"
          }
        },

        "public_config": {
          ".read": true,
          ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true",
          ".validate": "newData.hasChildren()"
        },

        "mesas": {
          "$mesaId": {
            ".read": "auth != null && (root.child('auth').child(auth.uid).child('roles').val().contains('mesero') || root.child('auth').child(auth.uid).child('admin').val() == true)",
            ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true"
          }
        },
        "pedidos": {
          "$pedidoId": {
            ".read": "auth != null && (root.child('auth').child(auth.uid).child('admin').val() == true || root.child('auth').child(auth.uid).child('roles').val().contains('mesero') || root.child('auth').child(auth.uid).child('roles').val().contains('cocina'))",
            ".write": "auth != null && (root.child('auth').child(auth.uid).child('admin').val() == true || root.child('auth').child(auth.uid).child('roles').val().contains('mesero'))"
          }
        },
        "pedido_items": {
          "$itemId": {
            ".read": "auth != null && (root.child('auth').child(auth.uid).child('admin').val() == true || root.child('auth').child(auth.uid).child('roles').val().contains('mesero') || root.child('auth').child(auth.uid).child('roles').val().contains('cocina'))",
            ".write": "auth != null && (root.child('auth').child(auth.uid).child('admin').val() == true || root.child('auth').child(auth.uid).child('roles').val().contains('mesero'))"
          }
        },
        "llamados_mesero": {
          "$llamadoId": {
            ".read": "auth != null && (root.child('auth').child(auth.uid).child('admin').val() == true || root.child('auth').child(auth.uid).child('roles').val().contains('mesero'))",
            ".write": "auth != null && (root.child('auth').child(auth.uid).child('roles').val().contains('mesero') || root.child('auth').child(auth.uid).child('admin').val() == true)"
          }
        },
        "cotizaciones": {
          "$id": {
            ".read": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true",
            ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true"
          }
        },
        "cotizacion_items": {
          "$id": { ".read": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true", ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true" }
        },
        "reservaciones": {
          "$id": { ".read": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true", ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true" }
        },
        "clientes": {
          "$id": { ".read": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true", ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true" }
        },
        "ventas": {
          "$id": { ".read": "auth != null && (root.child('auth').child(auth.uid).child('admin').val() == true || root.child('auth').child(auth.uid).child('roles').val().contains('cajero'))", ".write": "auth != null && (root.child('auth').child(auth.uid).child('admin').val() == true || root.child('auth').child(auth.uid).child('roles').val().contains('cajero'))" }
        },
        "usuarios": {
          "$usuarioId": { ".read": "auth != null && (auth.uid == $usuarioId || root.child('auth').child(auth.uid).child('admin').val() == true)", ".write": "auth != null && root.child('auth').child(auth.uid).child('admin').val() == true" }
        }
      }
    },

    "sync_audit": {
      "$auditId": {
        ".read": "auth != null && data.exists() && root.child('auth').child(auth.uid).child('restaurant_ids').val().contains(data.child('restaurant_id').val())",
        ".write": false
      }
    },

    "auth": {
      "$uid": {
        ".read": "auth != null && $uid == auth.uid",
        ".write": false
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && $uid == auth.uid",
        ".write": "auth != null && $uid == auth.uid"
      }
    }
  }
}
